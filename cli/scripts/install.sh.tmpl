#!/bin/sh
set -eu

default_version="__CLI_VERSION__"

version=$default_version
install_directory="${HOME:-}/.local/bin"
release_base_url=

usage() {
  cat >&2 <<'EOF'
Usage: install.sh --release-base-url HTTPS_URL [--version X.Y.Z] [--install-dir PATH]
EOF
  exit 2
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --version)
      [ "$#" -ge 2 ] || usage
      version=$2
      shift 2
      ;;
    --install-dir)
      [ "$#" -ge 2 ] || usage
      install_directory=$2
      shift 2
      ;;
    --release-base-url)
      [ "$#" -ge 2 ] || usage
      release_base_url=${2%/}
      shift 2
      ;;
    -h|--help)
      usage
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      ;;
  esac
done

[ -n "${HOME:-}" ] || {
  echo "HOME is required" >&2
  exit 1
}

case "$install_directory" in
  "~") install_directory=$HOME ;;
  "~/"*) install_directory=$HOME/${install_directory#\~/} ;;
  /*) ;;
  *)
    echo "Install directory must be absolute or start with ~/: $install_directory" >&2
    exit 2
    ;;
esac

case "/$install_directory/" in
  */../*|*/./*)
    echo "Install directory cannot contain . or .. path components" >&2
    exit 2
    ;;
esac

for command in uname curl shasum tar mktemp mkdir chmod mv awk cat rm; do
  command -v "$command" >/dev/null 2>&1 || {
    echo "Required command not found: $command" >&2
    exit 1
  }
done

if ! printf '%s\n' "$version" | awk -F. '
  NF != 3 { exit 1 }
  {
    for (i = 1; i <= 3; i++) {
      if ($i !~ /^[0-9]+$/ || (length($i) > 1 && substr($i, 1, 1) == "0")) {
        exit 1
      }
    }
  }
'; then
  echo "Invalid CLI version: $version" >&2
  exit 2
fi

[ -n "$release_base_url" ] || {
  echo "--release-base-url is required" >&2
  usage
}
case "$release_base_url" in
  https://*) ;;
  *)
    echo "Release base URL must use HTTPS" >&2
    exit 2
    ;;
esac
case "$release_base_url" in
  *[!A-Za-z0-9_~+%./:-]*)
    echo "Release base URL contains unsupported characters" >&2
    exit 2
    ;;
esac
release_host_and_path=${release_base_url#https://}
release_host=${release_host_and_path%%/*}
[ -n "$release_host" ] || {
  echo "Release base URL must include a host" >&2
  exit 2
}
case "$release_base_url" in
  */cli-v"$version") ;;
  *)
    echo "Release base URL must end with /cli-v$version" >&2
    exit 2
    ;;
esac

operating_system=$(uname -s)
machine=$(uname -m)
if [ "$operating_system" != "Darwin" ]; then
  echo "Agent Hub CLI Preview supports macOS only (detected $operating_system)." >&2
  exit 1
fi

case "$machine" in
  arm64) architecture=arm64 ;;
  x86_64) architecture=amd64 ;;
  *)
    echo "Unsupported macOS architecture: $machine" >&2
    exit 1
    ;;
esac

archive_name=agenthub_${version}_darwin_${architecture}.tar.gz

umask 077
temporary_directory=$(mktemp -d "${TMPDIR:-/tmp}/agent-hub-install.XXXXXX")
staged_binary=
cleanup() {
  [ -z "$staged_binary" ] || rm -f "$staged_binary"
  rm -rf "$temporary_directory"
}
trap cleanup EXIT HUP INT TERM

archive_path=$temporary_directory/$archive_name
checksums_path=$temporary_directory/checksums.txt

curl --fail --silent --show-error --location \
  --proto '=https' --tlsv1.2 \
  --output "$archive_path" \
  "$release_base_url/$archive_name"
curl --fail --silent --show-error --location \
  --proto '=https' --tlsv1.2 \
  --output "$checksums_path" \
  "$release_base_url/checksums.txt"

matching_checksums=$(awk -v asset="$archive_name" '$2 == asset { print $1 }' "$checksums_path")
match_count=$(printf '%s\n' "$matching_checksums" | awk 'NF { count++ } END { print count + 0 }')
if [ "$match_count" -ne 1 ]; then
  echo "Expected exactly one checksum for $archive_name" >&2
  exit 1
fi
expected_checksum=$matching_checksums
case "$expected_checksum" in
  *[!0-9a-fA-F]*|"")
    echo "Invalid checksum for $archive_name" >&2
    exit 1
    ;;
esac
if [ "${#expected_checksum}" -ne 64 ]; then
  echo "Invalid checksum length for $archive_name" >&2
  exit 1
fi

actual_checksum=$(shasum -a 256 "$archive_path" | awk '{ print $1 }')
if [ "$actual_checksum" != "$expected_checksum" ]; then
  echo "Checksum verification failed for $archive_name" >&2
  exit 1
fi

archive_entries=$(tar -tzf "$archive_path")
expected_entries=$(printf '%s\n' LICENSE README.md agenthub)
if [ "$archive_entries" != "$expected_entries" ]; then
  echo "Release archive contains unexpected files" >&2
  exit 1
fi

extracted_directory=$temporary_directory/extracted
mkdir -p "$extracted_directory"
tar -xzf "$archive_path" -C "$extracted_directory"
extracted_binary=$extracted_directory/agenthub
if [ ! -f "$extracted_binary" ] || [ -L "$extracted_binary" ]; then
  echo "Release archive does not contain a safe agenthub binary" >&2
  exit 1
fi

if [ -L "$install_directory" ]; then
  echo "Refusing symlinked install directory: $install_directory" >&2
  exit 1
fi
mkdir -p "$install_directory"
if [ -L "$install_directory" ]; then
  echo "Refusing symlinked install directory: $install_directory" >&2
  exit 1
fi

destination=$install_directory/agenthub
if [ -L "$destination" ]; then
  echo "Refusing symlinked destination: $destination" >&2
  exit 1
fi

staged_binary=$(mktemp "$install_directory/.agent-hub.XXXXXX")
cat "$extracted_binary" >"$staged_binary"
chmod 0755 "$staged_binary"
"$staged_binary" version >/dev/null
mv -f "$staged_binary" "$destination"
staged_binary=

echo "Installed Agent Hub CLI $version to $destination"
case ":${PATH:-}:" in
  *":$install_directory:"*) ;;
  *)
    echo "Add the install directory to PATH:"
    echo "  export PATH=\"$install_directory:\$PATH\""
    ;;
esac
echo "Run: agenthub version"
