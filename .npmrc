# Public npm registry — this is an open-source project, independent of any
# private/corporate registry configured on the developer machine.
registry=https://registry.npmjs.org/

# NOTE: the allowlist of packages permitted to run build scripts lives in
# pnpm-workspace.yaml under `onlyBuiltDependencies` (the correct pnpm 10+
# key). `approve-builds[]=` is not a valid .npmrc setting and did nothing.
