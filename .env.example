# --- Database ---
DATABASE_URL="postgresql://agenthub:agenthub@localhost:5432/agenthub"
# TEST_DATABASE_URL: separate DB for the e2e harness + `pnpm db:seed:test`.
# Never used by the app itself — keeps test runs from ever touching dev data.
# TEST_DATABASE_URL="postgresql://agenthub:agenthub@localhost:5432/agenthub_test"

# DB connection pool tuning — optional, defaults shown. `max` is *per app
# instance*; total connections against Postgres = max × instance count, so
# keep it under Postgres's own max_connections when scaling horizontally.
# DB_POOL_MAX=10
# DB_POOL_IDLE_MS=10000
# DB_POOL_CONN_TIMEOUT_MS=10000

# --- App URL (required for MCP endpoint and auth redirects) ---
NEXTAUTH_URL="http://localhost:3000"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Set to "true" when running behind a reverse proxy (nginx/Caddy/etc.) so
# Auth.js trusts the forwarded host, AND so rate limiting can trust the client
# IP from x-forwarded-for. Leave unset for direct localhost/dev — when unset,
# rate limiting can't identify individual clients and falls back to a single
# shared bucket (see server/lib/rate-limit).
# AUTH_TRUST_HOST="true"

# --- Rate limiting — optional, defaults shown ---
# Store backend: "memory" (default, in-process — per-instance, resets on
# restart, fine for single-instance self-host). Designed behind an interface
# so a shared store (e.g. redis) can be added later without code changes.
# RATE_LIMIT_STORE="memory"
# Login (per client IP): brute-force protection on the sign-in form.
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_MS=60000
# Registration (per client IP).
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_REGISTER_WINDOW_MS=60000
# MCP endpoint (per token, falling back to IP for unverifiable tokens).
# RATE_LIMIT_MCP_MAX=120
# RATE_LIMIT_MCP_WINDOW_MS=60000

# OAuth providers (tùy chọn — để trống thì nút tương ứng bị disable trên UI)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Superadmin bootstrap (one-time, for make db/create-root) ---
# ROOT_EMAIL="admin@example.com"
# ROOT_USERNAME="admin"
# ROOT_PASSWORD="change-me"

# --- Embedding ---
# Default: null (no embedding, keyword-only search — lightweight self-host).
# Set to "local" to enable hybrid semantic search across all artifacts (prompts,
# skills, plans, docs) — in the web UI, /search, and the MCP search_artifacts
# tool. Uses bge-m3 via transformers.js; downloads ~1-2 GB of weights on first run
# and a background reconciler backfills embeddings for existing artifacts.
# Set to "remote" to call a self-hosted HuggingFace Text Embeddings Inference
# (TEI) server instead (also bge-m3) — no local model download, requires
# EMBEDDER_URL pointing at the TEI server's base URL.
EMBEDDER="null"
# HF_HOME: where model weights are cached (mount as a Docker volume to avoid re-downloads)
# HF_HOME="/data/hf-cache"
# EMBEDDER_URL: base URL of the TEI server, only used when EMBEDDER=remote
# EMBEDDER_URL="http://localhost:8080"
# EMBEDDER_TOKEN: bearer token sent to the TEI server, if it sits behind a
# token-gating reverse proxy. Leave empty when the server has no auth.
# EMBEDDER_TOKEN=""
OPENAI_API_KEY=""
