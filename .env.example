# --- Database ---
DATABASE_URL="postgresql://prompthub:prompthub@localhost:5432/prompthub"

# --- App URL (required for MCP endpoint and auth redirects) ---
NEXTAUTH_URL="http://localhost:3000"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# OAuth providers (tùy chọn — để trống thì nút tương ứng bị disable trên UI)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Superadmin bootstrap (one-time, for make db/create-root) ---
# ROOT_EMAIL="admin@example.com"
# ROOT_PASSWORD="change-me"

# --- Embedding ---
# Default: null (no embedding, keyword-only search — lightweight self-host)
# Set to "local" to enable semantic search via bge-m3 (requires ~2 GB RAM on first load)
EMBEDDER="null"
# HF_HOME: where model weights are cached (mount as a Docker volume to avoid re-downloads)
# HF_HOME="/data/hf-cache"
OPENAI_API_KEY=""
